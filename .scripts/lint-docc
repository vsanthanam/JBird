#!/bin/bash

set -euo pipefail

temp_dir=$(mktemp -d)
trap 'rm -rf "$temp_dir"' EXIT

set +e
output=$(swift package \
    --allow-writing-to-directory "$temp_dir" \
    generate-documentation \
    --enable-experimental-combined-documentation \
    --product JBird \
    --product JBirdCore \
    --product JBirdBuilders \
    --product JBirdMacros \
    --product JBirdCodableSupport \
    --output-path "$temp_dir" \
    --transform-for-static-hosting \
    --hosting-base-path temp-docs 2>&1)
exit_code=$?
set -e

echo "$output"

summarize() {
    if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
        {
            echo "### Documentation"
            echo ""
            echo "$1"
            if [ -n "${2:-}" ]; then
                echo ""
                echo "<details>"
                echo "<summary>Diagnostics</summary>"
                echo ""
                echo '```'
                echo "$2"
                echo '```'
                echo ""
                echo "</details>"
            fi
        } >> "$GITHUB_STEP_SUMMARY"
    fi
}

if [ $exit_code -ne 0 ]; then
    echo "❌ Documentation generation failed with errors."
    summarize "❌ Documentation generation failed with errors." "$(echo "$output" | grep -E '\b(error|warning):' || true)"
    exit $exit_code
fi

if echo "$output" | grep -q '\bwarning:'; then
    echo "❌ Documentation generation succeeded, but warnings were emitted."
    summarize "❌ Documentation generation succeeded, but warnings were emitted." "$(echo "$output" | grep '\bwarning:')"
    exit 1
fi

echo "✅ Documentation generated without warnings."
summarize "✅ Documentation generated without warnings."
