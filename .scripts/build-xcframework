#!/bin/bash
set -euo pipefail

# Check if framework name is provided as first argument
if [ $# -eq 0 ]; then
  echo "❌ Error: Framework name is required as the first argument"
  echo "Usage: $0 <framework_name> [--static] [--platforms \"platform1,platform2,...\"]"
  exit 1
fi

FRAMEWORK_NAME="$1"
shift  # Remove the framework name from the arguments list

OUTPUT_DIR="Products"
ARCHIVE_DIR="$OUTPUT_DIR/archives"
XCFRAMEWORK_NAME="$FRAMEWORK_NAME.xcframework"

# Check if xcbeautify is available
XCBEAUTIFY_AVAILABLE=false
if command -v xcbeautify >/dev/null 2>&1; then
  XCBEAUTIFY_AVAILABLE=true
  echo "🧰 xcbeautify detected, will use for nicer output"
fi

# Parse arguments
BUILD_STATIC=false
PLATFORMS=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --static)
      BUILD_STATIC=true
      shift
      ;;
    --platforms)
      PLATFORMS="$2"
      shift 2
      ;;
    *)
      echo "Unknown option: $1"
      echo "Usage: $0 <framework_name> [--static] [--platforms \"platform1,platform2,...\"]"
      exit 1
      ;;
  esac
done

if [ "$BUILD_STATIC" = true ]; then
  echo "🔨 Building STATIC XCFramework"
else
  echo "🔨 Building DYNAMIC XCFramework"
fi

# Available platforms
ALL_PLATFORMS=("macos" "ios" "ios-simulator" "tvos" "tvos-simulator" "watchos" "watchos-simulator" "xros" "xros-simulator")

# If platforms are specified, use them; otherwise use all platforms
if [ -n "$PLATFORMS" ]; then
  IFS=',' read -ra SELECTED_PLATFORMS <<< "$PLATFORMS"
  echo "🎯 Building for platforms: ${PLATFORMS}"
else
  SELECTED_PLATFORMS=("${ALL_PLATFORMS[@]}")
  echo "🎯 Building for all platforms"
fi

rm -rf "$OUTPUT_DIR"
mkdir -p "$ARCHIVE_DIR"

build_archive() {
  local name="$1"
  local destination="$2"
  local sdk="$3"

  echo "📦 Archiving $name ($sdk) → $destination"

  # Base build settings
  build_settings=(
    -scheme "$FRAMEWORK_NAME"
    -destination "$destination"
    -archivePath "$ARCHIVE_DIR/$name.xcarchive"
    -sdk "$sdk"
    SKIP_INSTALL=NO
    BUILD_LIBRARY_FOR_DISTRIBUTION=YES
    CODE_SIGNING_ALLOWED=NO
    CODE_SIGN_IDENTITY=""
    OTHER_SWIFT_FLAGS="-DBUILD_XCFRAMEWORK"
    ONLY_ACTIVE_ARCH=NO
  )
  
  # Add static lib setting if --static flag was provided
  if [ "$BUILD_STATIC" = true ]; then
    build_settings+=(MACH_O_TYPE=staticlib)
  fi

  if [ "$XCBEAUTIFY_AVAILABLE" = true ]; then
    set -o pipefail
    xcodebuild archive "${build_settings[@]}" | xcbeautify
    local status=${PIPESTATUS[0]}
    if [ $status -ne 0 ]; then
      exit $status
    fi
  else
    xcodebuild archive "${build_settings[@]}"
  fi

  if [ "$BUILD_STATIC" = true ]; then
    local framework_path="$ARCHIVE_DIR/$name.xcarchive/Products/Library/Frameworks/$FRAMEWORK_NAME.framework"
    bundle_static_dependencies "$framework_path"
  fi

  # Ensure PrivacyInfo.xcprivacy is at the root of the framework
  local framework_path="$ARCHIVE_DIR/$name.xcarchive/Products/Library/Frameworks/$FRAMEWORK_NAME.framework"
  ensure_privacy_manifest_at_root "$framework_path"
}

ensure_privacy_manifest_at_root() {
  local framework_path="$1"
  local privacy_manifest="PrivacyInfo.xcprivacy"
  
  # Check if privacy manifest exists in Resources subdirectory
  if [ -f "$framework_path/Resources/$privacy_manifest" ]; then
    echo "📋 Moving $privacy_manifest to framework root"
    cp "$framework_path/Resources/$privacy_manifest" "$framework_path/$privacy_manifest"
  elif [ -f "$framework_path/$privacy_manifest" ]; then
    echo "✓ $privacy_manifest already at framework root"
  fi
}

bundle_static_dependencies() {
  local framework_path="$1"
  local framework_binary="$framework_path/$FRAMEWORK_NAME"
  local parent_dir
  parent_dir="$(dirname "$framework_path")"
  local dependencies_dirs=(
    "$framework_path/Frameworks"
    "$framework_path/Versions/Current/Frameworks"
    "$parent_dir"
  )

  for dependencies_dir in "${dependencies_dirs[@]}"; do
    if [ -d "$dependencies_dir" ]; then
      shopt -s nullglob
      for dependency in "$dependencies_dir"/*.framework; do
        if [ "$dependency" = "$framework_path" ]; then
          continue
        fi
        local dependency_name
        dependency_name="$(basename "$dependency" .framework)"
        local dependency_binary="$dependency/$dependency_name"
        if [ -f "$dependency_binary" ]; then
          if file "$dependency_binary" | grep -q "dynamically linked shared library"; then
            echo "⚠️ Skipping dynamic dependency $dependency_name when producing static framework"
          else
            echo "🔗 Bundling static dependency $dependency_name into $FRAMEWORK_NAME"
            /usr/bin/libtool -static -o "$framework_binary.merged" "$framework_binary" "$dependency_binary"
            mv "$framework_binary.merged" "$framework_binary"
          fi
        fi
        rm -rf "$dependency"
      done
      shopt -u nullglob
      if [ "$dependencies_dir" != "$parent_dir" ]; then
        rm -rf "$dependencies_dir"
      fi
    fi
  done
}

# Function to check if an item exists in an array
contains() {
  local item="$1"
  shift
  local array=("$@")
  for element in "${array[@]}"; do
    if [[ "$element" == "$item" ]]; then
      return 0
    fi
  done
  return 1
}

echo "🚧 Starting archives..."

# Build archives only for selected platforms
declare -a BUILT_PLATFORMS=()

if contains "macos" "${SELECTED_PLATFORMS[@]}"; then
  build_archive "macos" "generic/platform=macOS" macosx
  BUILT_PLATFORMS+=("macos")
fi

if contains "ios" "${SELECTED_PLATFORMS[@]}"; then
  build_archive "ios" "generic/platform=iOS" iphoneos
  BUILT_PLATFORMS+=("ios")
fi

if contains "ios-simulator" "${SELECTED_PLATFORMS[@]}"; then
  build_archive "ios-simulator" "generic/platform=iOS Simulator" iphonesimulator
  BUILT_PLATFORMS+=("ios-simulator")
fi

if contains "tvos" "${SELECTED_PLATFORMS[@]}"; then
  build_archive "tvos" "generic/platform=tvOS" appletvos
  BUILT_PLATFORMS+=("tvos")
fi

if contains "tvos-simulator" "${SELECTED_PLATFORMS[@]}"; then
  build_archive "tvos-simulator" "generic/platform=tvOS Simulator" appletvsimulator
  BUILT_PLATFORMS+=("tvos-simulator")
fi

if contains "watchos" "${SELECTED_PLATFORMS[@]}"; then
  build_archive "watchos" "generic/platform=watchOS" watchos
  BUILT_PLATFORMS+=("watchos")
fi

if contains "watchos-simulator" "${SELECTED_PLATFORMS[@]}"; then
  build_archive "watchos-simulator" "generic/platform=watchOS Simulator" watchsimulator
  BUILT_PLATFORMS+=("watchos-simulator")
fi

if contains "xros" "${SELECTED_PLATFORMS[@]}"; then
  build_archive "xros" "generic/platform=visionOS" xros
  BUILT_PLATFORMS+=("xros")
fi

if contains "xros-simulator" "${SELECTED_PLATFORMS[@]}"; then
  build_archive "xros-simulator" "generic/platform=visionOS Simulator" xrsimulator
  BUILT_PLATFORMS+=("xros-simulator")
fi

if [ ${#BUILT_PLATFORMS[@]} -eq 0 ]; then
  echo "❌ Error: No valid platforms selected. Exiting."
  exit 1
fi

echo "🧬 Creating XCFramework..."

# Prepare xcframework command with only built platforms
CMD_ARGS=()

for platform in "${BUILT_PLATFORMS[@]}"; do
  CMD_ARGS+=(-framework "$ARCHIVE_DIR/$platform.xcarchive/Products/Library/Frameworks/$FRAMEWORK_NAME.framework")
done

CMD_ARGS+=(-output "$OUTPUT_DIR/$XCFRAMEWORK_NAME")

if [ "$XCBEAUTIFY_AVAILABLE" = true ]; then
  set -o pipefail
  xcodebuild -create-xcframework "${CMD_ARGS[@]}" | xcbeautify
  status=${PIPESTATUS[0]}
  if [ $status -ne 0 ]; then
    exit $status
  fi
else
  xcodebuild -create-xcframework "${CMD_ARGS[@]}"
fi

echo "🎉 XCFramework created at $OUTPUT_DIR/$XCFRAMEWORK_NAME"

echo "📦 Compressing XCFramework..."

cd "$OUTPUT_DIR"
zip -r "$XCFRAMEWORK_NAME.zip" "$XCFRAMEWORK_NAME"

echo "✨ XCFramework compressed at $OUTPUT_DIR/$XCFRAMEWORK_NAME.zip"
