#!/bin/bash

xcodebuild \
  -scheme $1 \
  -configuration Release \
  -sdk watchos \
  -destination 'generic/platform=watchOS' \
  BUILD_LIBRARY_FOR_DISTRIBUTION=YES \
  WATCHOS_DEPLOYMENT_TARGET=8.0 \
  SKIP_INSTALL=NO \
  CODE_SIGN_IDENTITY="" \
  CODE_SIGNING_REQUIRED=NO \
  CODE_SIGNING_ALLOWED=NO \
  clean build
